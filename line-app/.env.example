# `line-app` — copy to `.env` (ignored by git) and fill in. Only the migration script reads this file
# by hand; the deployed functions get their env from Vercel.
#
#   node --env-file=.env scripts/migrate-blob-to-r2.js --dry    # count first
#   node --env-file=.env scripts/migrate-blob-to-r2.js          # then copy
#
# BLOB_READ_WRITE_TOKEN: Vercel → line-app → Storage → Blob → Tokens → Read & Write.
#   Only the copy needs it; the runtime uses OIDC and never reads this variable.
BLOB_READ_WRITE_TOKEN=
#
# R2: Cloudflare → R2 → Manage R2 API Tokens → Create API token
#   Permission "Object Read & Write", scoped to the one bucket (not "all buckets").
# Account ID is the subdomain of the S3 endpoint:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
