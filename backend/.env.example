# Copy to .env and adjust. Supabase: Project Settings > Database > Connection string (URI),
# then change the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/domplus

# Local development only: until LINE Login exists, pick a session with X-Dev-Property / X-Dev-Role headers.
# Never enable on a deployed server.
DEV_AUTH=false

# Only for pytest. This database is wiped on every test run, so never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/domplus_test
