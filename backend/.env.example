# Copy to .env and adjust. Supabase: Project Settings > Database > Connection string (URI),
# then change the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/domplus

# Local development only: until LINE Login exists, pick a session with X-Dev-Property / X-Dev-Role headers.
# Never enable on a deployed server.
DEV_AUTH=false

# LINE Login channel that issues the LIFF idToken (LINE Developers > channel > Basic settings > Channel ID).
# Leave empty and /v1/auth/line answers 503 LINE_NOT_CONFIGURED.
LINE_CHANNEL_ID=
# The LIFF app id, handed to the page by GET /v1/liff-config.
LIFF_ID=
# Messaging API channel secret (LINE Developers > channel > Basic settings). Verifies
# X-Line-Signature on POST /v1/webhooks/line/<PROPERTY_ID>. Empty = that endpoint answers 503.
# A dorm whose column `properties.line_secret_enc` is set uses that instead (scripts/set_line_secret.py).
LINE_CHANNEL_SECRET=
# Key for the encrypted per-dorm credentials above. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored secrets unreadable: the webhook answers 503 until you re-run the script.
SECRET_ENC_KEY=
# Signs the dp_session cookie. Use a long random value; changing it logs everybody out.
# The default below is refused by app/session.py — the API will not sign a session until you replace it.
SESSION_SECRET=dev-only-change-me
# true when the API is served over HTTPS (deployed), false for http://127.0.0.1.
COOKIE_SECURE=true
# Owner login for the web UI at /owner. One dorm per deployment, so this is one shared code;
# leave it empty to keep owner login off. Set a long random value and treat it like a password.
OWNER_ACCESS_CODE=

# Only for pytest. This database is wiped on every test run, so never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/domplus_test

# Vercel Cron: set this on the project and Vercel sends it as `Authorization: Bearer <CRON_SECRET>`
# on every scheduled run. `DUNNING_TOKEN` is accepted as the old name. A token in the URL is refused.
CRON_SECRET=
PROPERTY_ID=p_1
